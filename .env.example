# Leitura automática de comprovantes (opcional — sem isso o app funciona no modo manual)
# Crie a chave em console.anthropic.com → API Keys. No Vercel: Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Modelo de visão a usar (opcional). Padrão: claude-haiku-4-5
# OCR_MODEL=

# Google Drive (opcional). OAuth client "Web application" no Google Cloud, com a origem
# https://cofre-flax.vercel.app autorizada. Escopo usado: drive.file (só o que o app cria).
# Exposto ao navegador (NEXT_PUBLIC_) — um client ID web nao e segredo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Conta na nuvem (opcional). Supabase → Project Settings → API. A chave anon é pública por desenho;
# quem protege os dados é a RLS (supabase/schema.sql). Sem isso, o cofre fica só no aparelho.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
